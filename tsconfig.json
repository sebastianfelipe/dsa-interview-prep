{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@lib/*": ["./lib/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["lib/**/*.ts", "**/problems/**/*.ts", "vitest.solutions.config.ts"]
}
